{
  "name": "calculadora-microservicio",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "historial": "tsx servicios/historial/servidor.ts",
    "calculadora": "tsx servicios/calculadora/servidor.ts",
    "web": "tsx web/servidor.ts",
    "start": "concurrently -n historial,calculadora,web \"npm:historial\" \"npm:calculadora\" \"npm:web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
